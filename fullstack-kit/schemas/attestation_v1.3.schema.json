{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "pattern": "^P[0-7]$"
    },
    "scope": {
      "enum": [
        "project_acceptance",
        "production_release"
      ]
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,100}$"
    },
    "runner_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,100}$"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,100}$"
          },
          "kind": {
            "enum": [
              "test",
              "lint",
              "build",
              "security"
            ]
          },
          "scope": {
            "enum": [
              "project_acceptance",
              "production_release"
            ]
          },
          "command_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "run_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "receipt_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "environment_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mode": {
            "enum": [
              "CURRENT_ENV_CHECK",
              "ATTESTED_BUILD_ARTIFACT"
            ]
          },
          "artifact_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "exit_code": {
            "const": 0
          },
          "status": {
            "const": "success"
          },
          "started_utc": {
            "type": "string",
            "format": "date-time"
          },
          "finished_utc": {
            "type": "string",
            "format": "date-time"
          },
          "log_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "check_id",
          "kind",
          "scope",
          "command_hash",
          "run_id",
          "receipt_digest",
          "environment_digest",
          "mode",
          "artifact_digest",
          "exit_code",
          "status",
          "started_utc",
          "finished_utc",
          "log_digest"
        ],
        "allOf": [
          {
            "if": {
              "anyOf": [
                {
                  "properties": {
                    "mode": {
                      "const": "ATTESTED_BUILD_ARTIFACT"
                    }
                  }
                },
                {
                  "properties": {
                    "scope": {
                      "const": "production_release"
                    },
                    "kind": {
                      "const": "build"
                    }
                  }
                }
              ]
            },
            "then": {
              "properties": {
                "artifact_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        ]
      }
    },
    "issued_utc": {
      "type": "string",
      "format": "date-time"
    },
    "expires_utc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "project",
    "phase",
    "scope",
    "candidate_id",
    "runner_id",
    "source_digest",
    "policy_digest",
    "runs",
    "issued_utc",
    "expires_utc"
  ],
  "$comment": "Runtime additionally checks phase scope, unique check IDs, execution time ordering, max 24h lifetime, current receipts and signatures."
}
